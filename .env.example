# Copy to .env.local. Values come from `npx supabase status` after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. The service role key (SERVICE_ROLE_KEY in `npx supabase status -o env`; on the
# VM the generated one), for the analyse step's writes, which the API refuses a user.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. The similarity service (python services/similarity/server.py); unset = the stub.
SIMILARITY_URL=
# Server only. The feedback service's POST /feedback (RAG_SYSTEM, `python -m service`),
# e.g. http://127.0.0.1:8100/feedback. Empty: the feedback stub answers.
FEEDBACK_URL=
